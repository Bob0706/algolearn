# Copy to .env.local and fill in what you need. Everything is optional for local development.

# ── AI strategy generation (optional) ───────────────────────────────────
# Without a key, plain-English descriptions are mapped to parametrised templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Python strategy engine (backend/) ───────────────────────────────────
STRATEGY_ENGINE_URL=http://127.0.0.1:8000
# Shared secret; set the same value for the engine (backend/.env) in production
ENGINE_API_KEY=

# ── Market data ─────────────────────────────────────────────────────────
# If Yahoo Finance is unreachable, serve clearly-labelled synthetic prices (true) or fail (false)
ALLOW_SYNTHETIC_DATA=true

# ── Ledger (Hyperledger Besu) ──────────────────────────────────────────
# besu | local | off. Default: besu when the three LEDGER_* values below are set, otherwise local.
LEDGER_MODE=
LEDGER_RPC_URL=http://127.0.0.1:8545
# Platform signer. The default below is Besu's PUBLIC dev key — generate your own for any real network
# and add its address to blockchain/besu/permissions/permissions_config.toml.
LEDGER_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
# Printed by `npm run ledger:deploy`
LEDGER_CONTRACT_ADDRESS=
# Where the off-chain content behind each hash is stored
LEDGER_DATA_DIR=.ledger-data
# Salt for pseudonymous user ids on the ledger — set a long random value in production and never change it
LEDGER_SUBJECT_SALT=change-me

# ── Firebase (optional; without it the app runs with a local demo account) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Only needed if the API is served from another origin
NEXT_PUBLIC_API_URL=
