# ──────────────────────────────────────────
# AlgoLearn — .gitignore
# ──────────────────────────────────────────

# ── Python / FastAPI backend ──────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
.env
*.env
venv/
env/
.venv/
*.pyc

# ── Node.js / Next.js frontend ────────────
node_modules/
.next/
out/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Environment / Secrets ─────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── IDE / OS files ────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────
logs/
*.log
*.log.*

# ── Misc ──────────────────────────────────
*.pem
.vercel
